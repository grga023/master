<!-- ============================================================ -->
<!-- OLAP Kocka - XMLA Script za SQL Server Analysis Services     -->
<!-- Seminarski rad: Data Warehouse IT kompanije                   -->
<!-- Student: Ognjen Grgur, MIT 37/24                             -->
<!--                                                               -->
<!-- UPUTSTVO:                                                     -->
<!-- 1. Otvori SSMS                                                -->
<!-- 2. Connect -> Analysis Services -> localhost                   -->
<!-- 3. File -> New -> Analysis Services XMLA Query                 -->
<!-- 4. Zalepi ceo ovaj fajl                                       -->
<!-- 5. Execute (F5)                                                -->
<!-- 6. Posle: pokreni OLAP_kocka_PROCESS.xmla                     -->
<!-- ============================================================ -->
<!-- AKO VEC POSTOJI BAZA, PRVO OBRISI:                            -->
<!-- Desni klik na ITKompanijaDW_OLAP -> Delete                    -->
<!-- ============================================================ -->

<Batch xmlns="http://schemas.microsoft.com/analysisservices/2003/engine">
  <Create xmlns="http://schemas.microsoft.com/analysisservices/2003/engine">
    <ObjectDefinition>
      <Database xmlns:xsd="http://www.w3.org/2001/XMLSchema"
                xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance">
        <ID>ITKompanijaDW_OLAP</ID>
        <Name>ITKompanijaDW_OLAP</Name>

        <DataSources>
          <DataSource xsi:type="RelationalDataSource">
            <ID>ds_ITKompanijaDW</ID>
            <Name>ITKompanijaDW</Name>
            <ConnectionString>Provider=SQLNCLI11.1;Data Source=.\SQLEXPRESS;Initial Catalog=ITKompanijaDW;Integrated Security=SSPI;</ConnectionString>
            <ImpersonationInfo>
              <ImpersonationMode>ImpersonateServiceAccount</ImpersonationMode>
            </ImpersonationInfo>
          </DataSource>
        </DataSources>

        <DataSourceViews>
          <DataSourceView>
            <ID>dsv_ITKompanijaDW</ID>
            <Name>ITKompanijaDW DSV</Name>
            <DataSourceID>ds_ITKompanijaDW</DataSourceID>
            <Schema>
              <xs:schema xmlns:xs="http://www.w3.org/2001/XMLSchema" xmlns:msdata="urn:schemas-microsoft-com:xml-msdata" xmlns:msprop="urn:schemas-microsoft-com:xml-msprop">
                <xs:element name="dsv_ITKompanijaDW" msdata:IsDataSet="true">
                  <xs:complexType>
                    <xs:choice maxOccurs="unbounded">
                      <xs:element name="dbo_Analiza_troska_rada" msprop:DbSchemaName="dbo" msprop:DbTableName="Analiza_troska_rada" msprop:TableType="View" msprop:QueryDefinition="SELECT idEvidencije, idZaposlenog, imeZaposlenog, pozicija, nazivOdeljenja, idProjekta, nazivProjekta, statusProjekta, klijent, grad, drzava, datum, brojSati, satnica, TrosakRada, Godina, Mesec, Kvartal FROM dbo.Analiza_troska_rada">
                        <xs:complexType>
                          <xs:sequence>
                            <xs:element name="idEvidencije" type="xs:int" />
                            <xs:element name="idZaposlenog" type="xs:int" />
                            <xs:element name="imeZaposlenog" type="xs:string" minOccurs="0" />
                            <xs:element name="pozicija" type="xs:string" minOccurs="0" />
                            <xs:element name="nazivOdeljenja" type="xs:string" minOccurs="0" />
                            <xs:element name="idProjekta" type="xs:int" />
                            <xs:element name="nazivProjekta" type="xs:string" minOccurs="0" />
                            <xs:element name="statusProjekta" type="xs:string" minOccurs="0" />
                            <xs:element name="klijent" type="xs:string" minOccurs="0" />
                            <xs:element name="grad" type="xs:string" minOccurs="0" />
                            <xs:element name="drzava" type="xs:string" minOccurs="0" />
                            <xs:element name="datum" type="xs:dateTime" minOccurs="0" />
                            <xs:element name="brojSati" type="xs:decimal" minOccurs="0" />
                            <xs:element name="satnica" type="xs:decimal" minOccurs="0" />
                            <xs:element name="TrosakRada" type="xs:decimal" minOccurs="0" />
                            <xs:element name="Godina" type="xs:int" minOccurs="0" />
                            <xs:element name="Mesec" type="xs:int" minOccurs="0" />
                            <xs:element name="Kvartal" type="xs:int" minOccurs="0" />
                          </xs:sequence>
                        </xs:complexType>
                      </xs:element>
                      <xs:element name="dbo_Analiza_prihoda" msprop:DbSchemaName="dbo" msprop:DbTableName="Analiza_prihoda" msprop:TableType="View" msprop:QueryDefinition="SELECT idFakture, idProjekta, nazivProjekta, budzet, statusProjekta, klijent, grad, drzava, mesec, godina, ukupnoSati, iznos, statusFakture, Kvartal FROM dbo.Analiza_prihoda">
                        <xs:complexType>
                          <xs:sequence>
                            <xs:element name="idFakture" type="xs:int" />
                            <xs:element name="idProjekta" type="xs:int" />
                            <xs:element name="nazivProjekta" type="xs:string" minOccurs="0" />
                            <xs:element name="budzet" type="xs:decimal" minOccurs="0" />
                            <xs:element name="statusProjekta" type="xs:string" minOccurs="0" />
                            <xs:element name="klijent" type="xs:string" minOccurs="0" />
                            <xs:element name="grad" type="xs:string" minOccurs="0" />
                            <xs:element name="drzava" type="xs:string" minOccurs="0" />
                            <xs:element name="mesec" type="xs:int" minOccurs="0" />
                            <xs:element name="godina" type="xs:int" minOccurs="0" />
                            <xs:element name="ukupnoSati" type="xs:decimal" minOccurs="0" />
                            <xs:element name="iznos" type="xs:decimal" minOccurs="0" />
                            <xs:element name="statusFakture" type="xs:string" minOccurs="0" />
                            <xs:element name="Kvartal" type="xs:int" minOccurs="0" />
                          </xs:sequence>
                        </xs:complexType>
                      </xs:element>
                    </xs:choice>
                  </xs:complexType>
                  <xs:unique name="PK_troska" msdata:PrimaryKey="true">
                    <xs:selector xpath=".//dbo_Analiza_troska_rada" />
                    <xs:field xpath="idEvidencije" />
                  </xs:unique>
                  <xs:unique name="PK_prihoda" msdata:PrimaryKey="true">
                    <xs:selector xpath=".//dbo_Analiza_prihoda" />
                    <xs:field xpath="idFakture" />
                  </xs:unique>
                </xs:element>
              </xs:schema>
            </Schema>
          </DataSourceView>
        </DataSourceViews>

        <Dimensions>
          <Dimension>
            <ID>dim_Zaposleni</ID>
            <Name>Zaposleni</Name>
            <Source xsi:type="DataSourceViewBinding">
              <DataSourceViewID>dsv_ITKompanijaDW</DataSourceViewID>
            </Source>
            <Attributes>
              <Attribute>
                <ID>attr_Zaposleni</ID>
                <Name>Zaposleni</Name>
                <Usage>Key</Usage>
                <KeyColumns>
                  <KeyColumn>
                    <DataType>Integer</DataType>
                    <Source xsi:type="ColumnBinding">
                      <TableID>dbo_Analiza_troska_rada</TableID>
                      <ColumnID>idZaposlenog</ColumnID>
                    </Source>
                  </KeyColumn>
                </KeyColumns>
                <NameColumn>
                  <DataType>WChar</DataType>
                  <Source xsi:type="ColumnBinding">
                    <TableID>dbo_Analiza_troska_rada</TableID>
                    <ColumnID>imeZaposlenog</ColumnID>
