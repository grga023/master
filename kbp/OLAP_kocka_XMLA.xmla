                    <Source>
                      <DataType>Double</DataType>
                      <Source xsi:type="ColumnBinding">
                        <TableID>dbo_Analiza_prihoda</TableID>
                        <ColumnID>ukupnoSati</ColumnID>
                      </Source>
                    </Source>
                  </Measure>
                  <Measure>
                    <ID>m_Budzet</ID>
                    <Name>Budzet Projekta</Name>
                    <AggregateFunction>Sum</AggregateFunction>
                    <Source>
                      <DataType>Double</DataType>
                      <Source xsi:type="ColumnBinding">
                        <TableID>dbo_Analiza_prihoda</TableID>
                        <ColumnID>budzet</ColumnID>
                      </Source>
                    </Source>
                  </Measure>
                  <Measure>
                    <ID>m_BrojFaktura</ID>
                    <Name>Broj Faktura</Name>
                    <AggregateFunction>Count</AggregateFunction>
                    <Source>
                      <DataType>BigInt</DataType>
                      <Source xsi:type="ColumnBinding">
                        <TableID>dbo_Analiza_prihoda</TableID>
                        <ColumnID>idFakture</ColumnID>
                      </Source>
                    </Source>
                  </Measure>
                </Measures>
                <Dimensions>
                  <Dimension xsi:type="DegenerateMeasureGroupDimension">
                    <CubeDimensionID>cd2_Projekat</CubeDimensionID>
                    <Attributes>
                      <Attribute>
                        <AttributeID>attr_Projekat</AttributeID>
                        <KeyColumns>
                          <KeyColumn>
                            <DataType>Integer</DataType>
                            <Source xsi:type="ColumnBinding">
                              <TableID>dbo_Analiza_prihoda</TableID>
                              <ColumnID>idProjekta</ColumnID>
                            </Source>
                          </KeyColumn>
