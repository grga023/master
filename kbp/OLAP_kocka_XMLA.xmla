                <KeyColumns>
                  <KeyColumn>
                    <DataType>WChar</DataType>
                    <Source xsi:type="ColumnBinding">
                      <TableID>dbo_Analiza_troska_rada</TableID>
                      <ColumnID>pozicija</ColumnID>
                    </Source>
                  </KeyColumn>
                </KeyColumns>
              </Attribute>
            </Attributes>
          </Dimension>

          <Dimension>
            <ID>dim_Odeljenje</ID>
            <Name>Odeljenje</Name>
            <Source xsi:type="DataSourceViewBinding">
              <DataSourceViewID>dsv_ITKompanijaDW</DataSourceViewID>
            </Source>
            <Attributes>
              <Attribute>
                <ID>attr_Odeljenje</ID>
                <Name>Odeljenje</Name>
                <Usage>Key</Usage>
                <KeyColumns>
                  <KeyColumn>
                    <DataType>WChar</DataType>
                    <Source xsi:type="ColumnBinding">
                      <TableID>dbo_Analiza_troska_rada</TableID>
                      <ColumnID>nazivOdeljenja</ColumnID>
                    </Source>
                  </KeyColumn>
                </KeyColumns>
              </Attribute>
            </Attributes>
          </Dimension>

          <Dimension>
            <ID>dim_Projekat</ID>
            <Name>Projekat</Name>
            <Source xsi:type="DataSourceViewBinding">
              <DataSourceViewID>dsv_ITKompanijaDW</DataSourceViewID>
            </Source>
            <Attributes>
              <Attribute>
                <ID>attr_Projekat</ID>
                <Name>Projekat</Name>
                <Usage>Key</Usage>
                <KeyColumns>
                  <KeyColumn>
                    <DataType>Integer</DataType>
                    <Source xsi:type="ColumnBinding">
                      <TableID>dbo_Analiza_troska_rada</TableID>
                      <ColumnID>idProjekta</ColumnID>
                    </Source>
                  </KeyColumn>
                </KeyColumns>
                <NameColumn>
                  <DataType>WChar</DataType>
                  <Source xsi:type="ColumnBinding">
                    <TableID>dbo_Analiza_troska_rada</TableID>
                    <ColumnID>nazivProjekta</ColumnID>
                  </Source>
                </NameColumn>
              </Attribute>
              <Attribute>
                <ID>attr_StatusProjekta</ID>
                <Name>Status Projekta</Name>
                <KeyColumns>
                  <KeyColumn>
                    <DataType>WChar</DataType>
                    <Source xsi:type="ColumnBinding">
                      <TableID>dbo_Analiza_troska_rada</TableID>
                      <ColumnID>statusProjekta</ColumnID>
                    </Source>
                  </KeyColumn>
                </KeyColumns>
              </Attribute>
            </Attributes>
          </Dimension>

          <Dimension>
            <ID>dim_Klijent</ID>
            <Name>Klijent</Name>
            <Source xsi:type="DataSourceViewBinding">
              <DataSourceViewID>dsv_ITKompanijaDW</DataSourceViewID>
            </Source>
            <Attributes>
              <Attribute>
                <ID>attr_Klijent</ID>
                <Name>Klijent</Name>
                <Usage>Key</Usage>
                <KeyColumns>
                  <KeyColumn>
                    <DataType>WChar</DataType>
                    <Source xsi:type="ColumnBinding">
                      <TableID>dbo_Analiza_troska_rada</TableID>
                      <ColumnID>klijent</ColumnID>
                    </Source>
                  </KeyColumn>
                </KeyColumns>
              </Attribute>
              <Attribute>
                <ID>attr_Grad</ID>
                <Name>Grad</Name>
                <KeyColumns>
                  <KeyColumn>
                    <DataType>WChar</DataType>
                    <Source xsi:type="ColumnBinding">
                      <TableID>dbo_Analiza_troska_rada</TableID>
                      <ColumnID>grad</ColumnID>
                    </Source>
                  </KeyColumn>
                </KeyColumns>
              </Attribute>
              <Attribute>
                <ID>attr_Drzava</ID>
                <Name>Drzava</Name>
                <KeyColumns>
                  <KeyColumn>
                    <DataType>WChar</DataType>
                    <Source xsi:type="ColumnBinding">
                      <TableID>dbo_Analiza_troska_rada</TableID>
                      <ColumnID>drzava</ColumnID>
                    </Source>
                  </KeyColumn>
                </KeyColumns>
              </Attribute>
            </Attributes>
          </Dimension>

          <Dimension>
            <ID>dim_Vreme</ID>
            <Name>Vreme</Name>
            <Source xsi:type="DataSourceViewBinding">
              <DataSourceViewID>dsv_ITKompanijaDW</DataSourceViewID>
            </Source>
            <Attributes>
              <Attribute>
                <ID>attr_Godina</ID>
                <Name>Godina</Name>
                <Usage>Key</Usage>
                <KeyColumns>
                  <KeyColumn>
                    <DataType>Integer</DataType>
                    <Source xsi:type="ColumnBinding">
                      <TableID>dbo_Analiza_troska_rada</TableID>
                      <ColumnID>Godina</ColumnID>
                    </Source>
                  </KeyColumn>
                  <KeyColumn>
                    <DataType>Integer</DataType>
                    <Source xsi:type="ColumnBinding">
                      <TableID>dbo_Analiza_troska_rada</TableID>
                      <ColumnID>Kvartal</ColumnID>
                    </Source>
                  </KeyColumn>
                  <KeyColumn>
                    <DataType>Integer</DataType>
                    <Source xsi:type="ColumnBinding">
                      <TableID>dbo_Analiza_troska_rada</TableID>
                      <ColumnID>Mesec</ColumnID>
                    </Source>
                  </KeyColumn>
                </KeyColumns>
              </Attribute>
              <Attribute>
                <ID>attr_Kvartal</ID>
                <Name>Kvartal</Name>
                <KeyColumns>
                  <KeyColumn>
                    <DataType>Integer</DataType>
                    <Source xsi:type="ColumnBinding">
                      <TableID>dbo_Analiza_troska_rada</TableID>
                      <ColumnID>Kvartal</ColumnID>
                    </Source>
                  </KeyColumn>
                </KeyColumns>
              </Attribute>
              <Attribute>
                <ID>attr_Mesec</ID>
                <Name>Mesec</Name>
                <KeyColumns>
                  <KeyColumn>
                    <DataType>Integer</DataType>
                    <Source xsi:type="ColumnBinding">
                      <TableID>dbo_Analiza_troska_rada</TableID>
                      <ColumnID>Mesec</ColumnID>
                    </Source>
                  </KeyColumn>
                </KeyColumns>
              </Attribute>
            </Attributes>
            <Hierarchies>
              <Hierarchy>
                <ID>hier_Vreme</ID>
                <Name>Godina-Kvartal-Mesec</Name>
                <Levels>
                  <Level>
                    <ID>lvl_Godina</ID>
                    <Name>Godina</Name>
                    <SourceAttributeID>attr_Godina</SourceAttributeID>
                  </Level>
                  <Level>
                    <ID>lvl_Kvartal</ID>
                    <Name>Kvartal</Name>
                    <SourceAttributeID>attr_Kvartal</SourceAttributeID>
                  </Level>
                  <Level>
                    <ID>lvl_Mesec</ID>
                    <Name>Mesec</Name>
                    <SourceAttributeID>attr_Mesec</SourceAttributeID>
                  </Level>
                </Levels>
              </Hierarchy>
            </Hierarchies>
          </Dimension>
        </Dimensions>

        <Cubes>
          <!-- KOCKA: cbProduktivnost -->
          <Cube>
            <ID>cbProduktivnost</ID>
            <Name>cbProduktivnost</Name>
            <Source xsi:type="DataSourceViewBinding">
              <DataSourceViewID>dsv_ITKompanijaDW</DataSourceViewID>
            </Source>
            <Dimensions>
              <Dimension>
                <ID>cd_Zaposleni</ID>
                <Name>Zaposleni</Name>
                <DimensionID>dim_Zaposleni</DimensionID>
              </Dimension>
              <Dimension>
                <ID>cd_Odeljenje</ID>
                <Name>Odeljenje</Name>
                <DimensionID>dim_Odeljenje</DimensionID>
              </Dimension>
              <Dimension>
                <ID>cd_Projekat</ID>
                <Name>Projekat</Name>
                <DimensionID>dim_Projekat</DimensionID>
              </Dimension>
              <Dimension>
                <ID>cd_Klijent</ID>
                <Name>Klijent</Name>
                <DimensionID>dim_Klijent</DimensionID>
              </Dimension>
              <Dimension>
                <ID>cd_Vreme</ID>
                <Name>Vreme</Name>
                <DimensionID>dim_Vreme</DimensionID>
              </Dimension>
            </Dimensions>
            <MeasureGroups>
              <MeasureGroup>
                <ID>mg_Produktivnost</ID>
                <Name>Produktivnost</Name>
                <Measures>
                  <Measure>
                    <ID>m_BrojSati</ID>
                    <Name>Broj Sati</Name>
                    <AggregateFunction>Sum</AggregateFunction>
                    <Source>
                      <DataType>Double</DataType>
                      <Source xsi:type="ColumnBinding">
                        <TableID>dbo_Analiza_troska_rada</TableID>
                        <ColumnID>brojSati</ColumnID>
                      </Source>
                    </Source>
                  </Measure>
                  <Measure>
                    <ID>m_TrosakRada</ID>
                    <Name>Trosak Rada</Name>
                    <AggregateFunction>Sum</AggregateFunction>
                    <Source>
                      <DataType>Double</DataType>
                      <Source xsi:type="ColumnBinding">
                        <TableID>dbo_Analiza_troska_rada</TableID>
                        <ColumnID>TrosakRada</ColumnID>
                      </Source>
                    </Source>
                  </Measure>
                  <Measure>
                    <ID>m_ProsecnaSatnica</ID>
                    <Name>Prosecna Satnica</Name>
                    <AggregateFunction>Avg</AggregateFunction>
                    <Source>
                      <DataType>Double</DataType>
                      <Source xsi:type="ColumnBinding">
                        <TableID>dbo_Analiza_troska_rada</TableID>
                        <ColumnID>satnica</ColumnID>
                      </Source>
                    </Source>
                  </Measure>
                  <Measure>
