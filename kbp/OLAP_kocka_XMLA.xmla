                <DimensionID>dim_Vreme</DimensionID>
              </Dimension>
            </Dimensions>
            <MeasureGroups>
              <MeasureGroup>
                <ID>mg_Prihodi</ID>
                <Name>Prihodi</Name>
                <Measures>
                  <Measure>
                    <ID>m_Iznos</ID>
