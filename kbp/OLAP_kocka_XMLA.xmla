          <!-- KOCKA: cbPrihodi -->
          <Cube>
            <ID>cbPrihodi</ID>
            <Name>cbPrihodi</Name>
            <Source xsi:type="DataSourceViewBinding">
              <DataSourceViewID>dsv_ITKompanijaDW</DataSourceViewID>
            </Source>
            <Dimensions>
              <Dimension>
                <ID>cd2_Projekat</ID>
                <Name>Projekat</Name>
                <DimensionID>dim_Projekat</DimensionID>
              </Dimension>
              <Dimension>
                <ID>cd2_Klijent</ID>
                <Name>Klijent</Name>
                <DimensionID>dim_Klijent</DimensionID>
              </Dimension>
              <Dimension>
                <ID>cd2_Vreme</ID>
