                            <Source xsi:type="ColumnBinding">
                              <TableID>dbo_Analiza_troska_rada</TableID>
                              <ColumnID>Godina</ColumnID>
                            </Source>
                          </KeyColumn>
                          <KeyColumn>
                            <DataType>Integer</DataType>
                            <Source xsi:type="ColumnBinding">
                              <TableID>dbo_Analiza_troska_rada</TableID>
                              <ColumnID>Kvartal</ColumnID>
                            </Source>
                          </KeyColumn>
                          <KeyColumn>
                            <DataType>Integer</DataType>
                            <Source xsi:type="ColumnBinding">
                              <TableID>dbo_Analiza_troska_rada</TableID>
                              <ColumnID>Mesec</ColumnID>
                            </Source>
                          </KeyColumn>
                        </KeyColumns>
                      </Attribute>
                    </Attributes>
                  </Dimension>
                </Dimensions>
                <Partitions>
                  <Partition>
                    <ID>part_Produktivnost</ID>
                    <Name>Produktivnost</Name>
                    <Source xsi:type="TableBinding">
                      <DataSourceID>ds_ITKompanijaDW</DataSourceID>
                      <DbSchemaName>dbo</DbSchemaName>
                      <DbTableName>Analiza_troska_rada</DbTableName>
                    </Source>
                    <StorageMode>Molap</StorageMode>
                  </Partition>
                </Partitions>
              </MeasureGroup>
            </MeasureGroups>
