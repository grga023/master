                    <Name>Broj Evidencija</Name>
                    <AggregateFunction>Count</AggregateFunction>
                    <Source>
                      <DataType>BigInt</DataType>
                      <Source xsi:type="ColumnBinding">
                        <TableID>dbo_Analiza_troska_rada</TableID>
                        <ColumnID>idEvidencije</ColumnID>
                      </Source>
                    </Source>
                  </Measure>
                </Measures>
                <Dimensions>
                  <Dimension xsi:type="DegenerateMeasureGroupDimension">
                    <CubeDimensionID>cd_Zaposleni</CubeDimensionID>
                    <Attributes>
                      <Attribute>
                        <AttributeID>attr_Zaposleni</AttributeID>
                        <KeyColumns>
                          <KeyColumn>
                            <DataType>Integer</DataType>
                            <Source xsi:type="ColumnBinding">
                              <TableID>dbo_Analiza_troska_rada</TableID>
                              <ColumnID>idZaposlenog</ColumnID>
                            </Source>
                          </KeyColumn>
                        </KeyColumns>
                      </Attribute>
                    </Attributes>
                  </Dimension>
                  <Dimension xsi:type="DegenerateMeasureGroupDimension">
                    <CubeDimensionID>cd_Odeljenje</CubeDimensionID>
                    <Attributes>
                      <Attribute>
                        <AttributeID>attr_Odeljenje</AttributeID>
                        <KeyColumns>
                          <KeyColumn>
                            <DataType>WChar</DataType>
                            <Source xsi:type="ColumnBinding">
                              <TableID>dbo_Analiza_troska_rada</TableID>
                              <ColumnID>nazivOdeljenja</ColumnID>
                            </Source>
                          </KeyColumn>
                        </KeyColumns>
                      </Attribute>
                    </Attributes>
                  </Dimension>
                  <Dimension xsi:type="DegenerateMeasureGroupDimension">
                    <CubeDimensionID>cd_Projekat</CubeDimensionID>
                    <Attributes>
                      <Attribute>
                        <AttributeID>attr_Projekat</AttributeID>
                        <KeyColumns>
                          <KeyColumn>
                            <DataType>Integer</DataType>
                            <Source xsi:type="ColumnBinding">
                              <TableID>dbo_Analiza_troska_rada</TableID>
                              <ColumnID>idProjekta</ColumnID>
                            </Source>
                          </KeyColumn>
                        </KeyColumns>
                      </Attribute>
                    </Attributes>
                  </Dimension>
                  <Dimension xsi:type="DegenerateMeasureGroupDimension">
                    <CubeDimensionID>cd_Klijent</CubeDimensionID>
                    <Attributes>
                      <Attribute>
                        <AttributeID>attr_Klijent</AttributeID>
                        <KeyColumns>
                          <KeyColumn>
                            <DataType>WChar</DataType>
                            <Source xsi:type="ColumnBinding">
                              <TableID>dbo_Analiza_troska_rada</TableID>
                              <ColumnID>klijent</ColumnID>
                            </Source>
                          </KeyColumn>
                        </KeyColumns>
                      </Attribute>
                    </Attributes>
                  </Dimension>
                  <Dimension xsi:type="DegenerateMeasureGroupDimension">
                    <CubeDimensionID>cd_Vreme</CubeDimensionID>
                    <Attributes>
                      <Attribute>
                        <AttributeID>attr_Godina</AttributeID>
                        <KeyColumns>
                          <KeyColumn>
